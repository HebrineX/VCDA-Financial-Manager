@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using VCDA.FinancialManager.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@T["Identity.PersonalData.Title"] - @T["Identity.BrandSuffix"]</PageTitle>

<StatusMessage />
<h3>@T["Identity.PersonalData.Title"]</h3>

<div class="row">
    <div class="col-md-6">
        <p>@T["Identity.PersonalData.Description"]</p>
        <p>
            <strong>@T["Identity.DeletePersonalData.Warning"]</strong>
        </p>
        <form action="/Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">@T["Identity.PersonalData.Download"]</button>
        </form>
        <p>
            <a href="/Account/Manage/DeletePersonalData" class="btn btn-danger">@T["Identity.PersonalData.Delete"]</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
