@page "/Account/Manage/PersonalData"

@using Microsoft.AspNetCore.Identity
@using VCDA.FinancialManager.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>Datos personales - VCDA-Financial-Manager</PageTitle>

<StatusMessage />
<h3>Datos personales</h3>

<div class="row">
    <div class="col-md-6">
        <p>Tu cuenta contiene datos personales que proporcionaste a VCDA-Financial-Manager. Desde esta pantalla podés descargarlos o eliminar tu cuenta.</p>
        <p>
            <strong>Eliminar estos datos borra permanentemente tu cuenta y no se puede recuperar.</strong>
        </p>
        <form action="/Account/Manage/DownloadPersonalData" method="post">
            <AntiforgeryToken />
            <button class="btn btn-primary" type="submit">Descargar datos</button>
        </form>
        <p>
            <a href="/Account/Manage/DeletePersonalData" class="btn btn-danger">Eliminar cuenta</a>
        </p>
    </div>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user  = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
        }
    }
}
