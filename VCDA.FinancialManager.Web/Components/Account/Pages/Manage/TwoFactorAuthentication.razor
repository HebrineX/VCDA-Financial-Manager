@page "/Account/Manage/TwoFactorAuthentication"

@using Microsoft.AspNetCore.Http.Features
@using Microsoft.AspNetCore.Identity
@using VCDA.FinancialManager.Web.Data

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager

<PageTitle>@T["Identity.TwoFactor.Title"]</PageTitle>

<StatusMessage />
<h3>@T["Identity.TwoFactor.Title"]</h3>
@if (!is2faEnabled)
{
    if (isAdmin)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@T["Identity.TwoFactor.AdminRequiredTitle"]</strong>
            <p class="mb-0">@T["Identity.TwoFactor.AdminRequiredBody"]</p>
        </div>
    }
    else
    {
        <div class="alert alert-info" role="alert">
            <strong>@T["Identity.TwoFactor.RecommendedTitle"]</strong>
            <p class="mb-0">@T["Identity.TwoFactor.RecommendedBody"]</p>
        </div>
    }
}
@if (canTrack)
{
    if (is2faEnabled)
    {
        if (recoveryCodesLeft == 0)
        {
            <div class="alert alert-danger">
                <strong>@T["Identity.TwoFactor.NoCodesTitle"]</strong>
                <p><a href="Account/Manage/GenerateRecoveryCodes">@T["Identity.TwoFactor.GenerateNewSet"]</a>. @T["Identity.TwoFactor.GenerateBeforeLogin"]</p>
            </div>
        }
        else if (recoveryCodesLeft == 1)
        {
            <div class="alert alert-danger">
                <strong>@T["Identity.TwoFactor.OneCodeTitle"]</strong>
                <p><a href="Account/Manage/GenerateRecoveryCodes">@T["Identity.TwoFactor.GenerateNewSet"]</a>.</p>
            </div>
        }
        else if (recoveryCodesLeft <= 3)
        {
            <div class="alert alert-warning">
                <strong>@(string.Format(T["Identity.TwoFactor.SomeCodesTitle"], recoveryCodesLeft))</strong>
                <p>@T["Identity.TwoFactor.ShouldGenerate"] <a href="Account/Manage/GenerateRecoveryCodes">@T["Identity.TwoFactor.GenerateNewSet"]</a>.</p>
            </div>
        }

        if (isMachineRemembered)
        {
            <form style="display: inline-block" @formname="forget-browser" @onsubmit="OnSubmitForgetBrowserAsync" method="post">
                <AntiforgeryToken />
                <button type="submit" class="btn btn-primary">@T["Identity.TwoFactor.ForgetBrowser"]</button>
            </form>
        }

        <a href="Account/Manage/Disable2fa" class="btn btn-primary">@T["Identity.TwoFactor.Disable"]</a>
        <a href="Account/Manage/GenerateRecoveryCodes" class="btn btn-primary">@T["Identity.TwoFactor.ResetCodes"]</a>
    }

    <h4>@T["Identity.TwoFactor.AuthenticatorApp"]</h4>
    @if (!hasAuthenticator)
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@T["Identity.TwoFactor.AddAuthenticator"]</a>
    }
    else
    {
        <a href="Account/Manage/EnableAuthenticator" class="btn btn-primary">@T["Identity.TwoFactor.SetupAuthenticator"]</a>
        <a href="Account/Manage/ResetAuthenticator" class="btn btn-primary">@T["Identity.TwoFactor.ResetAuthenticator"]</a>
    }
}
else
{
    <div class="alert alert-danger">
        <strong>@T["Identity.TwoFactor.CookieTitle"]</strong>
        <p>@T["Identity.TwoFactor.CookieBody"]</p>
    </div>
}

@code {
    private bool canTrack;
    private bool hasAuthenticator;
    private int recoveryCodesLeft;
    private bool is2faEnabled;
    private bool isMachineRemembered;
    private bool isAdmin;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        canTrack = HttpContext.Features.Get<ITrackingConsentFeature>()?.CanTrack ?? true;
        hasAuthenticator = await UserManager.GetAuthenticatorKeyAsync(user) is not null;
        is2faEnabled = await UserManager.GetTwoFactorEnabledAsync(user);
        isMachineRemembered = await SignInManager.IsTwoFactorClientRememberedAsync(user);
        recoveryCodesLeft = await UserManager.CountRecoveryCodesAsync(user);
        isAdmin = await UserManager.IsInRoleAsync(user, AppRoles.Admin);
    }

    private async Task OnSubmitForgetBrowserAsync()
    {
        await SignInManager.ForgetTwoFactorClientAsync();

        RedirectManager.RedirectToCurrentPageWithStatus(
            T["Identity.TwoFactor.BrowserForgotten"],
            HttpContext);
    }
}
