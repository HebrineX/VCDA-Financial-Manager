@page "/cuentas"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using VCDA.FinancialManager.Domain.Entities
@using VCDA.FinancialManager.Web.Services
@inject FinancialService FinancialService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@T["Accounts.Title"] - @T["App.BrandName"]</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <!-- Listado de Cuentas -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-wallet2 me-2"></i> @T["Accounts.Header"]</h5>
                </div>
                <div class="card-body p-0">
                    @if (cuentas == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@T["Common.Loading"]</span>
                            </div>
                            <p class="mt-2 text-muted">@T["Accounts.Loading"]</p>
                        </div>
                    }
                    else if (!cuentas.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-cash-stack display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">@T["Accounts.EmptyTitle"]</h5>
                            <p class="text-muted small">@T["Accounts.EmptyText"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="py-3 ps-4">@T["Accounts.Name"]</th>
                                        <th class="py-3">@T["Accounts.Currency"]</th>
                                        <th class="py-3 text-end pe-4">@T["Accounts.Balance"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var cuenta in cuentas)
                                    {
                                        <tr>
                                            <td class="py-3 ps-4 fw-bold">
                                                <i class="bi bi-wallet2 text-primary me-2"></i> @cuenta.Nombre
                                            </td>
                                            <td class="py-3"><span class="badge bg-secondary">@cuenta.Moneda</span></td>
                                            <td class="py-3 text-end pe-4 fw-bold @(cuenta.Saldo >= 0 ? "text-success" : "text-danger")">
                                                @cuenta.Saldo.ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Formulario Crear Cuenta -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header card-header-accent py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i> @T["Accounts.New"]</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }
                    @if (successMessage)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @T["Accounts.Created"]
                        </div>
                    }

                    <EditForm Model="nuevaCuenta" OnValidSubmit="HandleCreateCuenta" FormName="CreateCuentaForm">
                        <DataAnnotationsValidator />
                        
                        <div class="mb-3">
                            <label for="nombre" class="form-label fw-bold">@T["Accounts.NameLabel"]</label>
                            <InputText id="nombre" class="form-control" placeholder="@T["Accounts.NamePlaceholder"]" @bind-Value="nuevaCuenta.Nombre" required />
                        </div>

                        <div class="mb-3">
                            <label for="saldo" class="form-label fw-bold">@T["Accounts.InitialBalance"]</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputNumber id="saldo" class="form-control" @bind-Value="nuevaCuenta.Saldo" required />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="moneda" class="form-label fw-bold">@T["Accounts.Currency"]</label>
                            <InputSelect id="moneda" class="form-select" @bind-Value="nuevaCuenta.Moneda">
                                <option value="ARS">ARS (Peso Argentino)</option>
                                <option value="USD">USD (Dólar Estadounidense)</option>
                                <option value="EUR">EUR (Euro)</option>
                            </InputSelect>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold">
                            <i class="bi bi-check-lg me-2"></i> @T["Accounts.Create"]
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Cuenta>? cuentas;
    private string? userId;
    private string? errorMessage;
    private bool successMessage = false;

    private CuentaFormModel nuevaCuenta = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            await CargarCuentas();
        }
    }

    private async Task CargarCuentas()
    {
        if (!string.IsNullOrEmpty(userId))
        {
            cuentas = await FinancialService.GetCuentasAsync(userId);
        }
    }

    private async Task HandleCreateCuenta()
    {
        errorMessage = null;
        successMessage = false;

        if (string.IsNullOrEmpty(userId))
        {
            errorMessage = T["Accounts.UserMissing"];
            return;
        }

        if (string.IsNullOrWhiteSpace(nuevaCuenta.Nombre))
        {
            errorMessage = T["Accounts.NameRequired"];
            return;
        }

        try
        {
            await FinancialService.CreateCuentaAsync(nuevaCuenta.Nombre, nuevaCuenta.Saldo, nuevaCuenta.Moneda, userId);
            successMessage = true;
            nuevaCuenta = new();
            await CargarCuentas();
        }
        catch (Exception ex)
        {
            errorMessage = string.Format(T["Accounts.CreateError"], ex.Message);
        }
    }

    public class CuentaFormModel
    {
        public string Nombre { get; set; } = string.Empty;
        public decimal Saldo { get; set; } = 0m;
        public string Moneda { get; set; } = "ARS";
    }
}
