@page "/admin/usuarios"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using System.Security.Claims
@using VCDA.FinancialManager.Web.Data
@using VCDA.FinancialManager.Web.Models
@using VCDA.FinancialManager.Web.Services
@inject AdminUserService AdminUserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JSRuntime

<PageTitle>Administración de Usuarios</PageTitle>

<div class="container-fluid py-4 animated-fade-in">
    <h2 class="fw-bold text-gradient mb-4"><span class="bi bi-people-fill me-2"></span> Gestión de Usuarios</h2>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (adminRequiresTwoFactor)
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            <h4 class="alert-heading">2FA obligatorio para administradores</h4>
            <p>
                Tu cuenta tiene permisos de administrador. Para operar el panel de usuarios,
                primero configurá una app autenticadora desde la seguridad de tu cuenta.
            </p>
            <a class="btn btn-primary" href="Account/Manage/TwoFactorAuthentication">Configurar 2FA</a>
        </div>
    }
    else if (users is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover m-0 align-middle">
                        <thead>
                            <tr>
                                <th class="ps-4">Usuario</th>
                                <th>Email</th>
                                <th>Roles</th>
                                <th>Email confirmado</th>
                                <th>Estado</th>
                                <th class="text-end pe-4">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                <tr>
                                    <td class="ps-4">@user.DisplayName</td>
                                    <td>@user.Email</td>
                                    <td>
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge @(role == "Admin" ? "bg-primary" : "bg-secondary") me-1">@role</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge bg-success">Sí</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">No</span>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsDeactivated)
                                        {
                                            <span class="badge bg-danger">Desactivado</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">Activo</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4">
                                        <div class="action-buttons">
                                            <button class="btn btn-sm @(user.IsAdmin ? "btn-outline-primary" : "btn-primary")"
                                                    disabled="@user.IsDeactivated"
                                                    title="@(user.IsAdmin ? "Quitar rol Admin" : "Asignar rol Admin")"
                                                    @onclick="() => ToggleAdminRole(user.Id, !user.IsAdmin)">
                                                @(user.IsAdmin ? "Quitar Admin" : "Hacer Admin")
                                            </button>
                                            <button class="btn btn-sm @(user.IsDeactivated ? "btn-success" : "btn-outline-danger")"
                                                    @onclick="() => SetUserDeactivation(user, !user.IsDeactivated)">
                                                @(user.IsDeactivated ? "Reactivar" : "Desactivar")
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<AdminUserViewModel>? users;
    private string? currentUserId;
    private string? statusMessage;
    private string? errorMessage;
    private bool adminRequiresTwoFactor;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var currentUser = await UserManager.GetUserAsync(authState.User);
        adminRequiresTwoFactor = currentUser is not null
            && await UserManager.IsInRoleAsync(currentUser, AppRoles.Admin)
            && !await UserManager.GetTwoFactorEnabledAsync(currentUser);

        if (adminRequiresTwoFactor)
        {
            return;
        }

        users = await AdminUserService.GetUsersAsync();
    }

    private async Task SetUserDeactivation(AdminUserViewModel user, bool deactivate)
    {
        errorMessage = null;
        statusMessage = null;

        if (deactivate)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"¿Confirmas la desactivación de {user.DisplayName}? El usuario no podrá acceder, pero sus transacciones y datos se conservan.");
            if (!confirmed)
            {
                return;
            }
        }

        var (success, error) = await AdminUserService.SetUserDeactivationAsync(user.Id, deactivate);
        if (!success)
        {
            errorMessage = error ?? "No se pudo cambiar el estado del usuario.";
            return;
        }

        users = await AdminUserService.GetUsersAsync();
        statusMessage = deactivate
            ? "Usuario desactivado. Sus transacciones y datos se conservaron."
            : "Usuario reactivado.";
    }

    private async Task ToggleAdminRole(string userId, bool makeAdmin)
    {
        errorMessage = null;
        statusMessage = null;
        var (success, error) = await AdminUserService.SetUserAdminRoleAsync(userId, makeAdmin, currentUserId);
        if (!success)
        {
            errorMessage = error;
            return;
        }

        users = await AdminUserService.GetUsersAsync();
        statusMessage = makeAdmin
            ? "Rol de administrador asignado."
            : "Rol de administrador removido.";
    }
}
