@page "/admin/usuarios"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using Microsoft.JSInterop
@using System.Security.Claims
@using VCDA.FinancialManager.Web.Data
@using VCDA.FinancialManager.Web.Models
@using VCDA.FinancialManager.Web.Services
@inject AdminUserService AdminUserService
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject IJSRuntime JSRuntime

<PageTitle>@T["Admin.PageTitle"]</PageTitle>

<div class="container-fluid py-4 animated-fade-in admin-users-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-2 align-items-lg-end mb-4">
        <div>
            <span class="vcda-kicker mb-2">@T["Admin.Kicker"]</span>
            <h2 class="fw-bold text-gradient mb-1"><span class="bi bi-people-fill me-2"></span> @T["Admin.UsersTitle"]</h2>
            <p class="text-muted mb-0">@T["Admin.Subtitle"]</p>
        </div>
        <span class="badge admin-users-count align-self-start align-self-lg-auto">
            <span class="bi bi-person-lines-fill me-1"></span>
            @(users?.Count ?? 0) @T["Admin.Users"]
        </span>
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            @statusMessage
            <button type="button" class="btn-close" @onclick="() => statusMessage = null"></button>
        </div>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
        </div>
    }

    @if (adminRequiresTwoFactor)
    {
        <div class="alert alert-warning shadow-sm" role="alert">
            <h4 class="alert-heading">@T["Admin.TwoFactorRequiredTitle"]</h4>
            <p>@T["Admin.TwoFactorRequiredBody"]</p>
            <a class="btn btn-primary" href="Account/Manage/TwoFactorAuthentication">@T["Admin.Configure2FA"]</a>
        </div>
    }
    else if (users is null)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="card admin-users-card">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover m-0 align-middle admin-users-table">
                        <thead>
                            <tr>
                                <th class="ps-4">@T["Admin.User"]</th>
                                <th>@T["Admin.Email"]</th>
                                <th>@T["Admin.Roles"]</th>
                                <th>@T["Admin.EmailConfirmed"]</th>
                                <th>@T["Admin.Status"]</th>
                                <th class="text-end pe-4">@T["Admin.Actions"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in users)
                            {
                                <tr>
                                    <td class="ps-4" data-label="@T["Admin.User"]">
                                        <div class="fw-bold">@user.DisplayName</div>
                                        <div class="text-muted small d-lg-none">@user.Email</div>
                                    </td>
                                    <td data-label="@T["Admin.Email"]">@user.Email</td>
                                    <td data-label="@T["Admin.Roles"]">
                                        @foreach (var role in user.Roles)
                                        {
                                            <span class="badge admin-role-badge @(role == "Admin" ? "admin-role-badge-primary" : "admin-role-badge-secondary") me-1">@role</span>
                                        }
                                    </td>
                                    <td data-label="@T["Admin.EmailConfirmed"]">
                                        @if (user.EmailConfirmed)
                                        {
                                            <span class="badge admin-status-badge admin-status-ok">@T["Common.Yes"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge admin-status-badge admin-status-muted">@T["Common.No"]</span>
                                        }
                                    </td>
                                    <td data-label="@T["Admin.Status"]">
                                        @if (user.IsDeactivated)
                                        {
                                            <span class="badge admin-status-badge admin-status-danger">@T["Admin.Deactivated"]</span>
                                        }
                                        else
                                        {
                                            <span class="badge admin-status-badge admin-status-ok">@T["Admin.Active"]</span>
                                        }
                                    </td>
                                    <td class="text-end pe-4" data-label="@T["Admin.Actions"]">
                                        <div class="action-buttons admin-action-buttons">
                                            <button class="btn btn-sm @(user.IsAdmin ? "btn-outline-primary" : "btn-primary")"
                                                    disabled="@user.IsDeactivated"
                                                    title="@(user.IsAdmin ? T["Admin.RemoveAdminTitle"] : T["Admin.MakeAdminTitle"])"
                                                    @onclick="() => ToggleAdminRole(user.Id, !user.IsAdmin)">
                                                <span class="bi @(user.IsAdmin ? "bi-shield-minus" : "bi-shield-plus") me-1"></span>
                                                <span>@(user.IsAdmin ? T["Admin.RemoveAdmin"] : T["Admin.MakeAdmin"])</span>
                                            </button>
                                            <button class="btn btn-sm @(user.IsDeactivated ? "btn-success" : "btn-outline-danger")"
                                                    @onclick="() => SetUserDeactivation(user, !user.IsDeactivated)">
                                                <span class="bi @(user.IsDeactivated ? "bi-person-check" : "bi-person-slash") me-1"></span>
                                                <span>@(user.IsDeactivated ? T["Admin.Reactivate"] : T["Admin.Deactivate"])</span>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<AdminUserViewModel>? users;
    private string? currentUserId;
    private string? statusMessage;
    private string? errorMessage;
    private bool adminRequiresTwoFactor;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        currentUserId = authState.User.FindFirstValue(ClaimTypes.NameIdentifier);
        var currentUser = await UserManager.GetUserAsync(authState.User);
        adminRequiresTwoFactor = currentUser is not null
            && await UserManager.IsInRoleAsync(currentUser, AppRoles.Admin)
            && !await UserManager.GetTwoFactorEnabledAsync(currentUser);

        if (adminRequiresTwoFactor)
        {
            return;
        }

        users = await AdminUserService.GetUsersAsync();
    }

    private async Task SetUserDeactivation(AdminUserViewModel user, bool deactivate)
    {
        errorMessage = null;
        statusMessage = null;

        if (deactivate)
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                string.Format(T["Admin.ConfirmDeactivate"], user.DisplayName));
            if (!confirmed)
            {
                return;
            }
        }

        var (success, error) = await AdminUserService.SetUserDeactivationAsync(user.Id, deactivate);
        if (!success)
        {
            errorMessage = error ?? T["Admin.StateChangeError"];
            return;
        }

        users = await AdminUserService.GetUsersAsync();
        statusMessage = deactivate
            ? T["Admin.StatusDeactivated"]
            : T["Admin.StatusReactivated"];
    }

    private async Task ToggleAdminRole(string userId, bool makeAdmin)
    {
        errorMessage = null;
        statusMessage = null;
        var (success, error) = await AdminUserService.SetUserAdminRoleAsync(userId, makeAdmin, currentUserId);
        if (!success)
        {
            errorMessage = error;
            return;
        }

        users = await AdminUserService.GetUsersAsync();
        statusMessage = makeAdmin
            ? T["Admin.StatusAdminAdded"]
            : T["Admin.StatusAdminRemoved"];
    }
}
