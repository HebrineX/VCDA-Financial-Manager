@page "/transacciones"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using VCDA.FinancialManager.Domain.Entities
@using VCDA.FinancialManager.Domain.Enums
@using VCDA.FinancialManager.Web.Services
@inject FinancialService FinancialService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@T["Transactions.Title"] - @T["App.BrandName"]</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <!-- Listado de Transacciones -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-list-columns-reverse me-2"></i> @T["Transactions.History"]</h5>
                </div>
                <div class="card-body p-0">
                    @if (transacciones == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">@T["Common.Loading"]</span>
                            </div>
                            <p class="mt-2 text-muted">@T["Transactions.Loading"]</p>
                        </div>
                    }
                    else if (!transacciones.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-file-earmark-diff display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">@T["Transactions.EmptyTitle"]</h5>
                            <p class="text-muted small">@T["Transactions.EmptyText"]</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle transactions-table">
                                <thead class="table-light">
                                    <tr>
                                        <th class="py-3 ps-4">@T["Home.Date"]</th>
                                        <th class="py-3">@T["Home.Account"]</th>
                                        <th class="py-3">@T["Home.Category"]</th>
                                        <th class="py-3">@T["Transactions.Description"]</th>
                                        <th class="py-3 text-center">@T["Transactions.Type"]</th>
                                        <th class="py-3 text-end pe-4">@T["Transactions.Amount"]</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in transacciones)
                                    {
                                        <tr>
                                            <td class="py-3 ps-4 text-muted">@tx.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="py-3 fw-semibold transaction-account-cell">@tx.Cuenta?.Nombre</td>
                                            <td class="py-3"><span class="badge badge-category">@tx.Categoria?.Nombre</span></td>
                                            <td class="py-3 transaction-description-cell">@tx.Descripcion</td>
                                            <td class="py-3 text-center">
                                                @if (tx.Tipo == TipoTransaccion.Ingreso)
                                                {
                                                    <span class="badge transaction-type-badge transaction-type-income px-2 py-1"><i class="bi bi-arrow-up-right me-1"></i> @T["Transactions.Income"]</span>
                                                }
                                                else
                                                {
                                                    <span class="badge transaction-type-badge transaction-type-expense px-2 py-1"><i class="bi bi-arrow-down-left me-1"></i> @T["Transactions.Expense"]</span>
                                                }
                                            </td>
                                            <td class="py-3 text-end pe-4 fw-bold @(tx.Tipo == TipoTransaccion.Ingreso ? "transaction-amount-income" : "transaction-amount-expense")">
                                                @(tx.Tipo == TipoTransaccion.Ingreso ? "+" : "-") @tx.Monto.ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Formulario Crear Transacción y Categorías -->
        <div class="col-lg-4">
            <!-- Form Nueva Transacción -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header card-header-accent py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i> @T["Transactions.RegisterMovement"]</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }
                    @if (successMessage)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> @T["Transactions.Success"]
                        </div>
                    }
                    @if (cuentas is { Count: 0 })
                    {
                        <div class="alert alert-warning" role="alert">
                            <i class="bi bi-wallet2 me-2"></i>
                            <span>@T["Transactions.NoAccount"]</span>
                            <a href="/cuentas" class="alert-link">@T["Transactions.CreateAccount"]</a>
                        </div>
                    }

                    <EditForm Model="nuevaTx" OnValidSubmit="HandleCreateTransaccion" FormName="CreateTxForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold">@T["Transactions.MovementType"]</label>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success flex-fill py-2 @(nuevaTx.Tipo == TipoTransaccion.Ingreso ? "active fw-bold" : "")"
                                        @onclick="() => SetTipoTx(TipoTransaccion.Ingreso)">
                                    <i class="bi bi-arrow-up-right me-1"></i> @T["Transactions.Income"]
                                </button>
                                <button type="button" class="btn btn-outline-danger flex-fill py-2 @(nuevaTx.Tipo == TipoTransaccion.Egreso ? "active fw-bold" : "")"
                                        @onclick="() => SetTipoTx(TipoTransaccion.Egreso)">
                                    <i class="bi bi-arrow-down-left me-1"></i> @T["Transactions.Expense"]
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="cuenta" class="form-label fw-bold">@T["Transactions.Account"]</label>
                            <InputSelect id="cuenta" class="@CuentaSelectCss" @bind-Value="nuevaTx.CuentaId" required disabled="@(cuentas is { Count: 0 })">
                                <option value="">@T["Transactions.SelectAccount"]</option>
                                @if (cuentas != null)
                                {
                                    @foreach (var c in cuentas)
                                    {
                                        <option value="@c.Id">@c.Nombre (@c.Saldo.ToString("C2"))</option>
                                    }
                                }
                            </InputSelect>
                            @if (!string.IsNullOrEmpty(cuentaValidation))
                            {
                                <div class="invalid-feedback d-block">@cuentaValidation</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="categoria" class="form-label fw-bold">@T["Transactions.Category"]</label>
                            <InputSelect id="categoria" class="@CategoriaSelectCss" @bind-Value="nuevaTx.CategoriaId" required disabled="@(!CategoriasParaTipo.Any())">
                                <option value="">@T["Transactions.SelectCategory"]</option>
                                @foreach (var cat in CategoriasParaTipo)
                                {
                                    <option value="@cat.Id">@cat.Nombre</option>
                                }
                            </InputSelect>
                            @if (!CategoriasParaTipo.Any())
                            {
                                <div class="form-text text-warning">@T["Transactions.NoCategoryForType"]</div>
                            }
                            @if (!string.IsNullOrEmpty(categoriaValidation))
                            {
                                <div class="invalid-feedback d-block">@categoriaValidation</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="monto" class="form-label fw-bold">@T["Transactions.Amount"]</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputText id="monto"
                                           class="@MontoInputCss"
                                           @bind-Value="nuevaTx.MontoTexto"
                                           inputmode="decimal"
                                           autocomplete="off"
                                           placeholder="0,00"
                                           required />
                            </div>
                            <div class="form-text text-muted">@T["Transactions.AmountHint"]</div>
                            @if (!string.IsNullOrEmpty(montoValidation))
                            {
                                <div class="invalid-feedback d-block">@montoValidation</div>
                            }
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label fw-bold">@T["Transactions.Description"]</label>
                            <InputText id="descripcion" class="form-control" placeholder="@T["Transactions.DescriptionPlaceholder"]" @bind-Value="nuevaTx.Descripcion" />
                        </div>

                        <div class="mb-3">
                            <label for="fecha" class="form-label fw-bold">@T["Transactions.Date"]</label>
                            <InputDate Type="InputDateType.DateTimeLocal" id="fecha" class="form-control" @bind-Value="nuevaTx.Fecha" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" disabled="@(!cuentas?.Any() ?? true)">
                            <i class="bi bi-save me-2"></i> @T["Transactions.Save"]
                        </button>
                    </EditForm>
                </div>
            </div>

            <!-- Form Nueva Categoría Rápida -->
            <div class="card shadow-sm border-0">
                <div class="card-header py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-tags me-2"></i> @T["Transactions.CreateCategory"]</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(catError))
                    {
                        <div class="alert alert-danger py-2" role="alert">
                            <small><i class="bi bi-exclamation-triangle-fill me-1"></i> @catError</small>
                        </div>
                    }
                    @if (catSuccess)
                    {
                        <div class="alert alert-success py-2" role="alert">
                            <small><i class="bi bi-check-circle-fill me-1"></i> @T["Transactions.CategoryCreated"]</small>
                        </div>
                    }

                    <EditForm Model="nuevaCat" OnValidSubmit="HandleCreateCategoria" FormName="CreateCatForm">
                        <DataAnnotationsValidator />

                        <div class="mb-2">
                            <label for="catNombre" class="form-label fw-semibold">@T["Transactions.CategoryName"]</label>
                            <InputText id="catNombre" class="form-control form-control-sm" placeholder="@T["Transactions.CategoryNamePlaceholder"]" @bind-Value="nuevaCat.Nombre" required />
                        </div>

                        <div class="mb-2">
                            <label for="catTipo" class="form-label fw-semibold">@T["Transactions.CategoryType"]</label>
                            <InputSelect id="catTipo" class="form-select form-select-sm" @bind-Value="nuevaCat.Tipo">
                                <option value="@TipoTransaccion.Egreso">@T["Transactions.ExpenseOption"]</option>
                                <option value="@TipoTransaccion.Ingreso">@T["Transactions.Income"]</option>
                            </InputSelect>
                        </div>

                        <button type="submit" class="btn btn-secondary btn-sm w-100 fw-bold">
                            <i class="bi bi-plus-lg me-1"></i> @T["Transactions.AddCategory"]
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Transaccion>? transacciones;
    private List<Cuenta>? cuentas;
    private List<Categoria>? categorias;
    private string? userId;
    
    private string? errorMessage;
    private bool successMessage = false;
    private string? cuentaValidation;
    private string? categoriaValidation;
    private string? montoValidation;

    private string? catError;
    private bool catSuccess = false;

    private TransaccionFormModel nuevaTx = new();
    private CategoriaFormModel nuevaCat = new();
    private IEnumerable<Categoria> CategoriasParaTipo =>
        categorias?.Where(c => c.Tipo == nuevaTx.Tipo) ?? Enumerable.Empty<Categoria>();
    private string CuentaSelectCss => cuentaValidation is null ? "form-select" : "form-select is-invalid";
    private string CategoriaSelectCss => categoriaValidation is null ? "form-select" : "form-select is-invalid";
    private string MontoInputCss => montoValidation is null ? "form-control" : "form-control is-invalid";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            await FinancialService.EnsureDefaultCategoriasAsync(userId);
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        if (string.IsNullOrEmpty(userId)) return;

        transacciones = await FinancialService.GetTransaccionesAsync(userId);
        cuentas = await FinancialService.GetCuentasAsync(userId);
        categorias = await FinancialService.GetCategoriasAsync(userId);
    }

    private void SetTipoTx(TipoTransaccion tipo)
    {
        nuevaTx.Tipo = tipo;
        nuevaTx.CategoriaId = Guid.Empty; // Reset category selection when type changes
        categoriaValidation = null;
    }

    private async Task HandleCreateTransaccion()
    {
        errorMessage = null;
        successMessage = false;
        cuentaValidation = null;
        categoriaValidation = null;
        montoValidation = null;

        if (string.IsNullOrEmpty(userId)) return;

        if (cuentas is null || cuentas.Count == 0)
        {
            errorMessage = T["Transactions.ErrorNoAccount"];
            cuentaValidation = T["Transactions.ValidationNoAccount"];
            return;
        }

        if (nuevaTx.CuentaId == Guid.Empty)
        {
            errorMessage = T["Transactions.ErrorAccountRequired"];
            cuentaValidation = T["Transactions.ValidationAccountRequired"];
            return;
        }

        if (!CategoriasParaTipo.Any())
        {
            errorMessage = T["Transactions.ErrorNoCategory"];
            categoriaValidation = T["Transactions.ValidationNoCategory"];
            return;
        }

        if (nuevaTx.CategoriaId == Guid.Empty)
        {
            errorMessage = T["Transactions.ErrorCategoryRequired"];
            categoriaValidation = T["Transactions.ValidationCategoryRequired"];
            return;
        }

        if (!TryParseMonto(nuevaTx.MontoTexto, out var monto) || monto <= 0)
        {
            errorMessage = T["Transactions.ErrorInvalidAmount"];
            montoValidation = T["Transactions.ValidationInvalidAmount"];
            return;
        }

        try
        {
            await FinancialService.CreateTransaccionAsync(
                nuevaTx.CuentaId,
                nuevaTx.CategoriaId,
                monto,
                nuevaTx.Descripcion,
                nuevaTx.Fecha,
                nuevaTx.Tipo,
                userId
            );

            successMessage = true;
            nuevaTx = new(); // Reset form
            await CargarDatos();
        }
        catch (Exception ex)
        {
            errorMessage = string.Format(T["Transactions.ErrorCreate"], ex.Message);
        }
    }

    private async Task HandleCreateCategoria()
    {
        catError = null;
        catSuccess = false;

        if (string.IsNullOrEmpty(userId)) return;

        if (string.IsNullOrWhiteSpace(nuevaCat.Nombre))
        {
            catError = T["Transactions.CategoryNameRequired"];
            return;
        }

        try
        {
            await FinancialService.CreateCategoriaAsync(nuevaCat.Nombre, "", nuevaCat.Tipo, userId);
            catSuccess = true;
            nuevaCat = new(); // Reset form
            await CargarDatos();
        }
        catch (Exception ex)
        {
            catError = string.Format(T["Transactions.CategoryError"], ex.Message);
        }
    }

    public class TransaccionFormModel
    {
        public Guid CuentaId { get; set; } = Guid.Empty;
        public Guid CategoriaId { get; set; } = Guid.Empty;
        public string MontoTexto { get; set; } = string.Empty;
        public string Descripcion { get; set; } = string.Empty;
        public DateTime Fecha { get; set; } = DateTime.Now;
        public TipoTransaccion Tipo { get; set; } = TipoTransaccion.Egreso;
    }

    private static bool TryParseMonto(string? value, out decimal monto)
    {
        var normalized = (value ?? string.Empty).Trim();
        normalized = normalized.Contains(',')
            ? normalized.Replace(".", "").Replace(',', '.')
            : normalized;

        return decimal.TryParse(
            normalized,
            System.Globalization.NumberStyles.Number,
            System.Globalization.CultureInfo.InvariantCulture,
            out monto);
    }

    public class CategoriaFormModel
    {
        public string Nombre { get; set; } = string.Empty;
        public TipoTransaccion Tipo { get; set; } = TipoTransaccion.Egreso;
    }
}
