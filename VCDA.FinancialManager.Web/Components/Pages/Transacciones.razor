@page "/transacciones"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using VCDA.FinancialManager.Domain.Entities
@using VCDA.FinancialManager.Domain.Enums
@using VCDA.FinancialManager.Web.Services
@inject FinancialService FinancialService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>Transacciones - VCDA-Financial-Manager</PageTitle>

<div class="container-fluid py-4">
    <div class="row">
        <!-- Listado de Transacciones -->
        <div class="col-lg-8 mb-4">
            <div class="card shadow-sm border-0">
                <div class="card-header d-flex align-items-center py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-list-columns-reverse me-2"></i> Historial de Movimientos</h5>
                </div>
                <div class="card-body p-0">
                    @if (transacciones == null)
                    {
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="mt-2 text-muted">Cargando movimientos...</p>
                        </div>
                    }
                    else if (!transacciones.Any())
                    {
                        <div class="text-center py-5">
                            <i class="bi bi-file-earmark-diff display-1 text-muted"></i>
                            <h5 class="mt-3 text-muted">No hay movimientos registrados</h5>
                            <p class="text-muted small">Registra tu primer ingreso o egreso en el panel lateral.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive">
                            <table class="table table-hover table-striped mb-0 align-middle">
                                <thead class="table-light">
                                    <tr>
                                        <th class="py-3 ps-4">Fecha</th>
                                        <th class="py-3">Cuenta</th>
                                        <th class="py-3">Categoría</th>
                                        <th class="py-3">Descripción</th>
                                        <th class="py-3 text-center">Tipo</th>
                                        <th class="py-3 text-end pe-4">Monto</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tx in transacciones)
                                    {
                                        <tr>
                                            <td class="py-3 ps-4 text-muted">@tx.Fecha.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                                            <td class="py-3 fw-semibold">@tx.Cuenta?.Nombre</td>
                                            <td class="py-3"><span class="badge badge-category">@tx.Categoria?.Nombre</span></td>
                                            <td class="py-3">@tx.Descripcion</td>
                                            <td class="py-3 text-center">
                                                @if (tx.Tipo == TipoTransaccion.Ingreso)
                                                {
                                                    <span class="badge bg-success-subtle text-success px-2 py-1"><i class="bi bi-arrow-up-right me-1"></i> Ingreso</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-danger-subtle text-danger px-2 py-1"><i class="bi bi-arrow-down-left me-1"></i> Egreso</span>
                                                }
                                            </td>
                                            <td class="py-3 text-end pe-4 fw-bold @(tx.Tipo == TipoTransaccion.Ingreso ? "text-success" : "text-danger")">
                                                @(tx.Tipo == TipoTransaccion.Ingreso ? "+" : "-") @tx.Monto.ToString("C2")
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Formulario Crear Transacción y Categorías -->
        <div class="col-lg-4">
            <!-- Form Nueva Transacción -->
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header card-header-accent py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-plus-circle me-2"></i> Registrar Movimiento</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(errorMessage))
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-triangle-fill me-2"></i> @errorMessage
                        </div>
                    }
                    @if (successMessage)
                    {
                        <div class="alert alert-success" role="alert">
                            <i class="bi bi-check-circle-fill me-2"></i> ¡Movimiento registrado!
                        </div>
                    }

                    <EditForm Model="nuevaTx" OnValidSubmit="HandleCreateTransaccion" FormName="CreateTxForm">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label fw-bold">Tipo de Movimiento</label>
                            <div class="d-flex gap-2">
                                <button type="button" class="btn btn-outline-success flex-fill py-2 @(nuevaTx.Tipo == TipoTransaccion.Ingreso ? "active fw-bold" : "")"
                                        @onclick="() => SetTipoTx(TipoTransaccion.Ingreso)">
                                    <i class="bi bi-arrow-up-right me-1"></i> Ingreso
                                </button>
                                <button type="button" class="btn btn-outline-danger flex-fill py-2 @(nuevaTx.Tipo == TipoTransaccion.Egreso ? "active fw-bold" : "")"
                                        @onclick="() => SetTipoTx(TipoTransaccion.Egreso)">
                                    <i class="bi bi-arrow-down-left me-1"></i> Egreso
                                </button>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="cuenta" class="form-label fw-bold">Cuenta de Origen/Destino</label>
                            <InputSelect id="cuenta" class="form-select" @bind-Value="nuevaTx.CuentaId" required>
                                <option value="">-- Seleccionar Cuenta --</option>
                                @if (cuentas != null)
                                {
                                    @foreach (var c in cuentas)
                                    {
                                        <option value="@c.Id">@c.Nombre (@c.Saldo.ToString("C2"))</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label for="categoria" class="form-label fw-bold">Categoría</label>
                            <InputSelect id="categoria" class="form-select" @bind-Value="nuevaTx.CategoriaId" required>
                                <option value="">-- Seleccionar Categoría --</option>
                                @if (categorias != null)
                                {
                                    @foreach (var cat in categorias.Where(c => c.Tipo == nuevaTx.Tipo))
                                    {
                                        <option value="@cat.Id">@cat.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <div class="mb-3">
                            <label for="monto" class="form-label fw-bold">Monto</label>
                            <div class="input-group">
                                <span class="input-group-text">$</span>
                                <InputNumber id="monto" class="form-control" @bind-Value="nuevaTx.Monto" required min="0.01" step="0.01" />
                            </div>
                        </div>

                        <div class="mb-3">
                            <label for="descripcion" class="form-label fw-bold">Descripción</label>
                            <InputText id="descripcion" class="form-control" placeholder="Ej: Supermercado, Alquiler, etc." @bind-Value="nuevaTx.Descripcion" />
                        </div>

                        <div class="mb-3">
                            <label for="fecha" class="form-label fw-bold">Fecha</label>
                            <InputDate Type="InputDateType.DateTimeLocal" id="fecha" class="form-control" @bind-Value="nuevaTx.Fecha" required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2 fw-bold" disabled="@(!cuentas?.Any() ?? true)">
                            <i class="bi bi-save me-2"></i> Guardar Movimiento
                        </button>
                    </EditForm>
                </div>
            </div>

            <!-- Form Nueva Categoría Rápida -->
            <div class="card shadow-sm border-0">
                <div class="card-header py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-tags me-2"></i> Crear Categoría</h5>
                </div>
                <div class="card-body">
                    @if (!string.IsNullOrEmpty(catError))
                    {
                        <div class="alert alert-danger py-2" role="alert">
                            <small><i class="bi bi-exclamation-triangle-fill me-1"></i> @catError</small>
                        </div>
                    }
                    @if (catSuccess)
                    {
                        <div class="alert alert-success py-2" role="alert">
                            <small><i class="bi bi-check-circle-fill me-1"></i> Categoría creada</small>
                        </div>
                    }

                    <EditForm Model="nuevaCat" OnValidSubmit="HandleCreateCategoria" FormName="CreateCatForm">
                        <DataAnnotationsValidator />

                        <div class="mb-2">
                            <label for="catNombre" class="form-label fw-semibold">Nombre de Categoría</label>
                            <InputText id="catNombre" class="form-control form-control-sm" placeholder="Ej: Servicios, Salidas" @bind-Value="nuevaCat.Nombre" required />
                        </div>

                        <div class="mb-2">
                            <label for="catTipo" class="form-label fw-semibold">Tipo de Categoría</label>
                            <InputSelect id="catTipo" class="form-select form-select-sm" @bind-Value="nuevaCat.Tipo">
                                <option value="@TipoTransaccion.Egreso">Egreso (Gasto)</option>
                                <option value="@TipoTransaccion.Ingreso">Ingreso</option>
                            </InputSelect>
                        </div>

                        <button type="submit" class="btn btn-secondary btn-sm w-100 fw-bold">
                            <i class="bi bi-plus-lg me-1"></i> Agregar Categoría
                        </button>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Transaccion>? transacciones;
    private List<Cuenta>? cuentas;
    private List<Categoria>? categorias;
    private string? userId;
    
    private string? errorMessage;
    private bool successMessage = false;

    private string? catError;
    private bool catSuccess = false;

    private TransaccionFormModel nuevaTx = new();
    private CategoriaFormModel nuevaCat = new();

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        userId = user.FindFirst(c => c.Type == System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;

        if (!string.IsNullOrEmpty(userId))
        {
            await FinancialService.EnsureDefaultCategoriasAsync(userId);
            await CargarDatos();
        }
    }

    private async Task CargarDatos()
    {
        if (string.IsNullOrEmpty(userId)) return;

        transacciones = await FinancialService.GetTransaccionesAsync(userId);
        cuentas = await FinancialService.GetCuentasAsync(userId);
        categorias = await FinancialService.GetCategoriasAsync(userId);
    }

    private void SetTipoTx(TipoTransaccion tipo)
    {
        nuevaTx.Tipo = tipo;
        nuevaTx.CategoriaId = Guid.Empty; // Reset category selection when type changes
    }

    private async Task HandleCreateTransaccion()
    {
        errorMessage = null;
        successMessage = false;

        if (string.IsNullOrEmpty(userId)) return;

        if (nuevaTx.CuentaId == Guid.Empty)
        {
            errorMessage = "Debe seleccionar una cuenta.";
            return;
        }

        if (nuevaTx.CategoriaId == Guid.Empty)
        {
            errorMessage = "Debe seleccionar una categoría.";
            return;
        }

        if (nuevaTx.Monto <= 0)
        {
            errorMessage = "El monto debe ser mayor a cero.";
            return;
        }

        try
        {
            await FinancialService.CreateTransaccionAsync(
                nuevaTx.CuentaId,
                nuevaTx.CategoriaId,
                nuevaTx.Monto,
                nuevaTx.Descripcion,
                nuevaTx.Fecha,
                nuevaTx.Tipo,
                userId
            );

            successMessage = true;
            nuevaTx = new(); // Reset form
            await CargarDatos();
        }
        catch (Exception ex)
        {
            errorMessage = $"Error al registrar movimiento: {ex.Message}";
        }
    }

    private async Task HandleCreateCategoria()
    {
        catError = null;
        catSuccess = false;

        if (string.IsNullOrEmpty(userId)) return;

        if (string.IsNullOrWhiteSpace(nuevaCat.Nombre))
        {
            catError = "El nombre es requerido.";
            return;
        }

        try
        {
            await FinancialService.CreateCategoriaAsync(nuevaCat.Nombre, "", nuevaCat.Tipo, userId);
            catSuccess = true;
            nuevaCat = new(); // Reset form
            await CargarDatos();
        }
        catch (Exception ex)
        {
            catError = $"Error: {ex.Message}";
        }
    }

    public class TransaccionFormModel
    {
        public Guid CuentaId { get; set; } = Guid.Empty;
        public Guid CategoriaId { get; set; } = Guid.Empty;
        public decimal Monto { get; set; } = 0m;
        public string Descripcion { get; set; } = string.Empty;
        public DateTime Fecha { get; set; } = DateTime.Now;
        public TipoTransaccion Tipo { get; set; } = TipoTransaccion.Egreso;
    }

    public class CategoriaFormModel
    {
        public string Nombre { get; set; } = string.Empty;
        public TipoTransaccion Tipo { get; set; } = TipoTransaccion.Egreso;
    }
}
