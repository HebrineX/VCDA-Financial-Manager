@page "/importar"
@attribute [Authorize]
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using VCDA.FinancialManager.Domain.Entities
@using VCDA.FinancialManager.Web.Models
@using VCDA.FinancialManager.Web.Services
@inject FinancialService FinancialService
@inject AuthenticationStateProvider AuthenticationStateProvider

<PageTitle>@T["Import.Title"]</PageTitle>

<div class="container-fluid py-4 animated-fade-in import-csv-page">
    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3 align-items-lg-end mb-4">
        <div>
            <span class="vcda-kicker mb-2">@T["Import.Kicker"]</span>
            <h2 class="fw-bold text-gradient mb-1"><span class="bi bi-upload me-2"></span> @T["Import.Title"]</h2>
            <p class="text-muted mb-0">@T["Import.Subtitle"]</p>
        </div>
        <a class="btn btn-outline-primary"
           href="/templates/importacion-transacciones-ejemplo.csv"
           download="importacion-transacciones-ejemplo.csv">
            <span class="bi bi-download me-1"></span> @T["Import.DownloadTemplate"]
        </a>
    </div>

    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="import-csv-stat">
                <span class="bi bi-wallet2"></span>
                <div>
                    <div class="fw-bold">@cuentas.Count @T["Import.Accounts"]</div>
                    <small class="text-muted">@T["Import.AccountsHelp"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="import-csv-stat">
                <span class="bi bi-tags"></span>
                <div>
                    <div class="fw-bold">@categorias.Count @T["Import.Categories"]</div>
                    <small class="text-muted">@T["Import.CategoriesHelp"]</small>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="import-csv-stat">
                <span class="bi bi-filetype-csv"></span>
                <div>
                    <div class="fw-bold">@T["Import.MaxSize"]</div>
                    <small class="text-muted">@T["Import.DecimalHelp"]</small>
                </div>
            </div>
        </div>
    </div>

    <div class="card mb-4 import-csv-card">
        <div class="card-body">
            <p class="text-muted small mb-3">
                <span>@T["Import.Format"]</span>
                <code>@T["Import.FormatColumns"]</code>
            </p>
            <ul class="import-csv-tips text-muted small">
                <li>@T["Import.TipNames"]</li>
                <li>@T["Import.TipType"]</li>
                <li>@T["Import.TipQuotes"]</li>
            </ul>
            @if (!CanUploadCsv)
            {
                <div class="alert alert-warning mb-3" role="alert">
                    <span class="bi bi-exclamation-triangle-fill me-1"></span>
                    <span>@T["Import.MissingSetup"]</span>
                </div>
            }
            <InputFile OnChange="OnFileSelected" class="form-control" accept=".csv,text/csv" disabled="@(!CanUploadCsv)" />
            @if (!string.IsNullOrEmpty(importMessage) && !parsedRows.Any())
            {
                <div class="alert alert-info mt-3 mb-0">@importMessage</div>
            }
        </div>
    </div>

    @if (parsedRows.Any())
    {
        <div class="card mb-4">
            <div class="card-header d-flex justify-content-between align-items-center">
                <span class="fw-bold">@T["Import.Preview"]</span>
                <span class="badge bg-primary">@ValidRowsCount @T["Import.Valid"] / @parsedRows.Count @T["Import.Total"]</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-sm m-0 import-csv-preview-table">
                        <thead>
                            <tr>
                                <th class="ps-3">#</th>
                                <th>@T["Home.Date"]</th>
                                <th>@T["Transactions.Description"]</th>
                                <th>@T["Transactions.Amount"]</th>
                                <th>@T["Transactions.Type"]</th>
                                <th>@T["Transactions.Category"]</th>
                                <th>@T["Transactions.Account"]</th>
                                <th>@T["Import.Status"]</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in parsedRows)
                            {
                                <tr class="@(row.IsValid ? "" : "table-danger")">
                                    <td class="ps-3">@row.LineNumber</td>
                                    <td>@(row.Fecha?.ToString("yyyy-MM-dd") ?? "-")</td>
                                    <td>@row.Descripcion</td>
                                    <td>@(row.Monto?.ToString("N2") ?? "-")</td>
                                    <td>@(row.Tipo?.ToString() ?? "-")</td>
                                    <td>@row.CategoriaNombre</td>
                                    <td>@row.CuentaNombre</td>
                                    <td>
                                        @if (row.IsValid)
                                        {
                                            <span class="badge admin-status-badge admin-status-ok">OK</span>
                                        }
                                        else
                                        {
                                            <span class="text-danger fw-semibold">@row.ErrorMessage</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
            <div class="card-footer">
                @if (!string.IsNullOrEmpty(importMessage))
                {
                    <div class="alert alert-info mb-3">@importMessage</div>
                }
                <button class="btn btn-primary" disabled="@(ValidRowsCount == 0)" @onclick="ConfirmarImportacion">
                    <span class="bi bi-check2-circle me-1"></span>
                    <span>@T["Import.Confirm"]</span> (@ValidRowsCount @T["Import.Rows"])
                </button>
            </div>
        </div>
    }
</div>

@code {
    private string userId = "";
    private List<CsvImportRow> parsedRows = [];
    private List<Cuenta> cuentas = [];
    private List<Categoria> categorias = [];
    private string? importMessage;
    private bool CanUploadCsv => cuentas.Count > 0 && categorias.Count > 0;
    private int ValidRowsCount => parsedRows.Count(r => r.IsValid);

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ?? "";
        if (!string.IsNullOrEmpty(userId))
        {
            await FinancialService.EnsureDefaultCategoriasAsync(userId);
            cuentas = await FinancialService.GetCuentasAsync(userId);
            categorias = await FinancialService.GetCategoriasAsync(userId);
        }
    }

    private async Task OnFileSelected(InputFileChangeEventArgs e)
    {
        importMessage = null;
        var file = e.File;
        if (file is null) return;
        if (!CanUploadCsv)
        {
            importMessage = T["Import.MissingSetup"];
            return;
        }

        await using var stream = file.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
        using var reader = new StreamReader(stream);
        var content = await reader.ReadToEndAsync();
        parsedRows = CsvImportParser.Parse(content, cuentas, categorias);
    }

    private async Task ConfirmarImportacion()
    {
        try
        {
            var count = await FinancialService.ImportTransaccionesBatchAsync(parsedRows, userId);
            importMessage = string.Format(T["Import.Success"], count);
            cuentas = await FinancialService.GetCuentasAsync(userId);
            parsedRows = [];
        }
        catch (Exception ex)
        {
            importMessage = string.Format(T["Import.Error"], ex.Message);
        }
    }
}
