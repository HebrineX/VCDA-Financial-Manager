@inherits LayoutComponentBase
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using VCDA.FinancialManager.Web.Data
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject UserManager<ApplicationUser> UserManager
@inject NavigationManager NavigationManager
@inject UiText T
@inject AppVersionProvider AppVersion

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 justify-content-between align-items-center">
            <div class="topbar-brand shell-centered-blur d-flex align-items-center gap-3">
                <img src="brand-mark.svg" alt="VCDA-Financial-Manager" class="topbar-brand-mark" />
                <div class="brand-title-block">
                    <span class="fs-5 fw-bold text-primary text-gradient d-block">@T["App.BrandName"]</span>
                    <span class="brand-subtitle">@T["App.Tagline"]</span>
                </div>
            </div>
            <div class="topbar-actions d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized Context="authContext">
                        <span class="topbar-user text-muted small d-none d-md-inline" aria-label="@T["App.UserMenu"]">
                            <span class="shell-icon shell-icon-user" aria-hidden="true"></span>
                            @GetHeaderUserName(authContext.User)
                        </span>
                        <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2"
                                type="button"
                                onclick="window.openVcdaTutorial()">
                            <span class="shell-icon shell-icon-guide" aria-hidden="true"></span>
                            <span>@T["Guide.Open"]</span>
                        </button>
                    </Authorized>
                </AuthorizeView>
                <button class="btn btn-sm btn-outline-secondary d-flex align-items-center gap-2 theme-toggle-btn" 
                        id="themeToggleBtn"
                        type="button"
                        data-light-label="@T["Theme.Light"]"
                        data-dark-label="@T["Theme.Dark"]"
                        aria-label="@T["Theme.Toggle"]"
                        data-theme-toggle="true">
                    <span id="themeToggleIcon" class="shell-icon shell-icon-sun" aria-hidden="true"></span>
                    <span id="themeToggleText">@T["Theme.Light"]</span>
                </button>
                <a class="btn btn-sm btn-outline-secondary language-toggle-btn"
                        href="@CultureToggleUrl"
                        data-enhance-nav="false"
                        aria-label="@T["Language.Toggle"]"
                        title="@T["Language.Toggle"]">
                    <span class="shell-icon shell-icon-language" aria-hidden="true"></span>
                    <span id="languageToggleText">@T.CurrentLanguageLabel</span>
                </a>
                <span class="app-version-pill d-none d-lg-inline-flex">
                    @T["App.Version"] @AppVersion.Version
                </span>
            </div>
        </div>

        <article class="content px-4 animated-fade-in">
            @Body
        </article>
    </main>
</div>

<AuthorizeView>
    <Authorized Context="tutorialContext">
        <div id="firstLoginTutorial"
             class="vcda-tutorial-backdrop d-none"
             role="dialog"
             aria-modal="true"
             aria-labelledby="tutorialTitle"
             data-tutorial-user="@(tutorialContext.User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? tutorialContext.User.Identity?.Name ?? "anonymous")">
            <div class="vcda-tutorial-card">
                <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
                    <div>
                        <span class="vcda-kicker mb-2">@T["Guide.Kicker"]</span>
                        <h2 id="tutorialTitle" class="fw-bold mb-1">@T["Guide.Title"]</h2>
                        <p class="text-muted mb-0">@T["Guide.Subtitle"]</p>
                    </div>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.closeVcdaTutorial()">@T["Common.Close"]</button>
                </div>

                <div class="btn-group w-100 mb-3" role="group" aria-label="Modo de tutorial">
                    <button type="button" class="btn btn-outline-primary active" data-tutorial-mode="fast" onclick="window.setVcdaTutorialMode('fast')">@T["Guide.Normal"]</button>
                    <button type="button" class="btn btn-outline-primary" data-tutorial-mode="detail" onclick="window.setVcdaTutorialMode('detail')">@T["Guide.Detail"]</button>
                </div>

                <div data-tutorial-panel="fast">
                    <ol class="vcda-tutorial-steps">
                        <li>@((MarkupString)T["Guide.Normal.1"])</li>
                        <li>@((MarkupString)T["Guide.Normal.2"])</li>
                        <li>@((MarkupString)T["Guide.Normal.3"])</li>
                        <li>@((MarkupString)T["Guide.Normal.4"])</li>
                    </ol>
                </div>

                <div data-tutorial-panel="detail" class="d-none">
                    <ol class="vcda-tutorial-steps">
                        <li>@((MarkupString)T["Guide.Detail.1"])</li>
                        <li>@((MarkupString)T["Guide.Detail.2"])</li>
                        <li>@((MarkupString)T["Guide.Detail.3"])</li>
                        <li>@((MarkupString)T["Guide.Detail.4"])</li>
                        <li>@((MarkupString)T["Guide.Detail.5"])</li>
                        <li>@((MarkupString)T["Guide.Detail.6"])</li>
                    </ol>
                </div>

                <div class="d-flex flex-column flex-sm-row gap-2 mt-4">
                    <a href="/cuentas" class="btn btn-primary flex-fill" onclick="window.closeVcdaTutorial()">@T["Guide.CreateFirstAccount"]</a>
                    <button type="button" class="btn btn-outline-secondary flex-fill" onclick="window.closeVcdaTutorial()">@T["Guide.Seen"]</button>
                </div>
            </div>
        </div>
    </Authorized>
</AuthorizeView>

<div id="blazor-error-ui" data-nosnippet>
    @T["Shell.Error"]
    <a href="." class="reload">@T["Shell.Reload"]</a>
    <span class="dismiss">x</span>
</div>

@code {
    private string? headerNickname;
    private string CultureToggleUrl => $"/culture/set?culture={Uri.EscapeDataString(T.NextCulture)}&returnUrl={Uri.EscapeDataString(NavigationManager.ToBaseRelativePath(NavigationManager.Uri) is { Length: > 0 } relative ? "/" + relative : "/")}";

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
        var user = await UserManager.GetUserAsync(authState.User);
        headerNickname = string.IsNullOrWhiteSpace(user?.Nickname) ? null : user.Nickname;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("window.syncThemeButton");
            await JS.InvokeVoidAsync("window.showVcdaTutorialIfNeeded");
        }
    }

    private string? GetHeaderUserName(ClaimsPrincipal principal)
    {
        return headerNickname
            ?? principal.FindFirst(ClaimTypes.Email)?.Value
            ?? principal.Identity?.Name;
    }
}
