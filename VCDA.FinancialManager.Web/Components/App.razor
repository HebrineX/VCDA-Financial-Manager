@using System.Globalization
@using System.Text.Json
@inject UiText T
@inject IHttpContextAccessor HttpContextAccessor

<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" data-theme="@InitialTheme">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["VCDA.FinancialManager.Web.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
    <script>
        window.vcdaBehaviorText = @((MarkupString)JsonSerializer.Serialize(BehaviorText));

        window.readVcdaStoredTheme = function () {
            const cookieTheme = document.cookie
                .split('; ')
                .find(function (row) { return row.startsWith('vcda-theme='); })
                ?.split('=')[1];

            if (cookieTheme === 'dark' || cookieTheme === 'light') {
                return cookieTheme;
            }

            try {
                const localTheme = localStorage.getItem('theme');
                return localTheme === 'dark' ? 'dark' : 'light';
            } catch {
                return 'light';
            }
        };

        window.storeVcdaTheme = function (theme) {
            document.cookie = 'vcda-theme=' + theme + ';path=/;max-age=31536000;samesite=lax';
            try {
                localStorage.setItem('theme', theme);
            } catch {
                // Cookie persistence is enough when storage is unavailable.
            }
        };

        window.applyVcdaTheme = function (theme) {
            const normalizedTheme = theme === 'dark' ? 'dark' : 'light';
            document.documentElement.setAttribute('data-theme', normalizedTheme);
            document.body?.setAttribute('data-theme', normalizedTheme);
            return normalizedTheme;
        };

        (function () {
            window.applyVcdaTheme(window.readVcdaStoredTheme());
        })();

        window.getVcdaLanguage = function () {
            const htmlLang = (document.documentElement.getAttribute('lang') || '').toLowerCase();
            return htmlLang.startsWith('en') ? 'en' : 'es';
        };

        window.tVcda = function (key) {
            return window.vcdaBehaviorText?.[key] || key;
        };

        window.syncThemeButton = function () {
            const theme = document.documentElement.getAttribute('data-theme') || 'light';
            const icon = document.getElementById('themeToggleIcon');
            const text = document.getElementById('themeToggleText');
            const button = document.getElementById('themeToggleBtn');

            if (icon) {
                icon.className = theme === 'dark' ? 'shell-icon shell-icon-moon' : 'shell-icon shell-icon-sun';
            }

            if (text && button) {
                text.textContent = theme === 'dark' ? button.dataset.darkLabel : button.dataset.lightLabel;
            }
        };

        window.toggleApplicationTheme = function () {
            const html = document.documentElement;
            const current = html.getAttribute('data-theme') || 'light';
            const next = current === 'dark' ? 'light' : 'dark';
            window.applyVcdaTheme(next);
            window.storeVcdaTheme(next);
            window.syncThemeButton();
        };

        window.togglePasswordVisibility = function (button) {
            const targetId = button?.getAttribute('data-toggle-password');
            const input = targetId ? document.getElementById(targetId) : null;
            if (!input) return;

            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            button.setAttribute('aria-pressed', (!visible).toString());
            button.setAttribute('aria-label', visible ? button.dataset.showLabel : button.dataset.hideLabel);
            const icon = button.querySelector('.bi');
            if (icon) {
                icon.className = visible ? 'bi bi-eye' : 'bi bi-eye-slash';
            }
        };

        window.validateRegisterForm = function (form) {
            const password = form.querySelector('#Input\\.Password')?.value || '';
            const confirm = form.querySelector('#Input\\.ConfirmPassword')?.value || '';
            const email = form.querySelector('#Input\\.Email')?.value || '';
            const errors = [];
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (!email.trim()) errors.push(window.tVcda('Register.EmailRequired'));
            else if (!emailRegex.test(email)) errors.push(window.tVcda('Register.EmailInvalid'));
            if (password.length < 8) errors.push(window.tVcda('Register.PasswordMin'));
            if (!/[a-z]/.test(password)) errors.push(window.tVcda('Register.PasswordLower'));
            if (!/[A-Z]/.test(password)) errors.push(window.tVcda('Register.PasswordUpper'));
            if (!/[0-9]/.test(password)) errors.push(window.tVcda('Register.PasswordDigit'));
            if (!/[^a-zA-Z0-9]/.test(password)) errors.push(window.tVcda('Register.PasswordSymbol'));
            if (password !== confirm) errors.push(window.tVcda('Register.PasswordMismatch'));

            const box = document.getElementById('registerClientErrors');
            if (errors.length > 0) {
                if (box) {
                    box.innerHTML = '<strong>' + window.tVcda('Register.ClientHeader') + '</strong><ul class="mb-0 mt-2"><li>' + errors.join('</li><li>') + '</li></ul>';
                    box.classList.remove('d-none');
                }
                return false;
            }

            box?.classList.add('d-none');
            const submit = form.querySelector('[data-register-submit="true"]');
            if (submit) {
                submit.disabled = true;
                submit.dataset.originalText = submit.textContent;
                submit.textContent = window.tVcda('Register.Creating');
            }
            return true;
        };

        window.startConfirmEmailRedirect = function () {
            let remaining = 5;
            const countdown = document.getElementById('confirmEmailCountdown');
            if (!countdown || countdown.dataset.started === 'true') return;
            countdown.dataset.started = 'true';

            const timer = window.setInterval(function () {
                remaining -= 1;
                countdown.textContent = remaining.toString();
                if (remaining <= 0) {
                    window.clearInterval(timer);
                    window.location.href = '/';
                }
            }, 1000);
        };

        window.setVcdaTutorialMode = function (mode) {
            document.querySelectorAll('[data-tutorial-mode]').forEach(function (button) {
                button.classList.toggle('active', button.dataset.tutorialMode === mode);
            });
            document.querySelectorAll('[data-tutorial-panel]').forEach(function (panel) {
                panel.classList.toggle('d-none', panel.dataset.tutorialPanel !== mode);
            });
        };

        window.getVcdaTutorialUserKey = function () {
            const modal = document.getElementById('firstLoginTutorial');
            const accountPanel = document.querySelector('[data-tutorial-account-user]');
            return modal?.dataset.tutorialUser || accountPanel?.dataset.tutorialAccountUser || 'anonymous';
        };

        window.closeVcdaTutorial = function () {
            const modal = document.getElementById('firstLoginTutorial');
            const userKey = window.getVcdaTutorialUserKey();
            localStorage.setItem('vcdaTutorialSeen:' + userKey, 'true');
            modal?.classList.add('d-none');
        };

        window.openVcdaTutorial = function () {
            document.getElementById('firstLoginTutorial')?.classList.remove('d-none');
        };

        window.reactivateVcdaTutorial = function () {
            const userKey = window.getVcdaTutorialUserKey();
            localStorage.removeItem('vcdaTutorialSeen:' + userKey);
            window.setVcdaTutorialAccountStatus?.('Tutorial.Account.StatusReady');
        };

        window.markVcdaTutorialSeen = function () {
            const userKey = window.getVcdaTutorialUserKey();
            localStorage.setItem('vcdaTutorialSeen:' + userKey, 'true');
            window.setVcdaTutorialAccountStatus?.('Tutorial.Account.StatusSeen');
        };

        window.setVcdaTutorialAccountStatus = function (translationKey) {
            const status = document.getElementById('tutorialAccountStatus');
            if (!status) return;
            status.textContent = window.tVcda(translationKey);
            status.classList.remove('d-none');
        };

        window.showVcdaTutorialIfNeeded = function () {
            const modal = document.getElementById('firstLoginTutorial');
            const userKey = window.getVcdaTutorialUserKey();
            if (!modal || localStorage.getItem('vcdaTutorialSeen:' + userKey) === 'true') return;
            modal.classList.remove('d-none');
        };

        document.addEventListener('click', function (event) {
            if (event.target.closest('[data-theme-toggle]')) {
                window.toggleApplicationTheme();
                return;
            }

            const button = event.target.closest('[data-toggle-password]');
            if (button) {
                window.togglePasswordVisibility(button);
            }
        });

        document.addEventListener('submit', function (event) {
            if (event.target?.matches?.('[data-vcda-register-form="true"]') && !window.validateRegisterForm(event.target)) {
                event.preventDefault();
                event.stopPropagation();
            }
        }, true);

        window.syncVcdaThemeFromStorage = function () {
            window.applyVcdaTheme(window.readVcdaStoredTheme());
            window.syncThemeButton();
        };

        document.addEventListener('DOMContentLoaded', window.syncVcdaThemeFromStorage);
        document.addEventListener('enhancedload', window.syncVcdaThemeFromStorage);
        window.addEventListener('pageshow', window.syncVcdaThemeFromStorage);
    </script>
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>

@code {
    private string InitialTheme
    {
        get
        {
            var theme = HttpContextAccessor.HttpContext?.Request.Cookies["vcda-theme"];
            return string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase) ? "dark" : "light";
        }
    }

    private Dictionary<string, string> BehaviorText => new(StringComparer.OrdinalIgnoreCase)
    {
        ["Register.ClientHeader"] = T["Register.ClientHeader"],
        ["Register.EmailRequired"] = T["Register.EmailRequired"],
        ["Register.EmailInvalid"] = T["Register.EmailInvalid"],
        ["Register.PasswordMin"] = T["Register.PasswordMin"],
        ["Register.PasswordLower"] = T["Register.PasswordLower"],
        ["Register.PasswordUpper"] = T["Register.PasswordUpper"],
        ["Register.PasswordDigit"] = T["Register.PasswordDigit"],
        ["Register.PasswordSymbol"] = T["Register.PasswordSymbol"],
        ["Register.PasswordMismatch"] = T["Register.PasswordMismatch"],
        ["Register.Creating"] = T["Register.Creating"],
        ["Tutorial.Account.StatusReady"] = T["Tutorial.Account.StatusReady"],
        ["Tutorial.Account.StatusSeen"] = T["Tutorial.Account.StatusSeen"]
    };
}
