        const vcdaReversePhraseTranslations = Object.fromEntries(
            Object.entries(vcdaPhraseTranslations).map(([es, en]) => [en, es])
        );

        window.getVcdaLanguage = function () {
            const saved = localStorage.getItem('vcdaLanguage');
            if (saved === 'en' || saved === 'es') return saved;
            return (navigator.language || '').toLowerCase().startsWith('en') ? 'en' : 'es';
        };

        window.tVcda = function (key) {
            const lang = window.getVcdaLanguage();
            return vcdaTranslations[lang]?.[key] || vcdaTranslations.es[key] || key;
        };

        window.applyVcdaLanguage = function () {
            if (window.vcdaApplyingLanguage) return;
            window.vcdaApplyingLanguage = true;
            const lang = window.getVcdaLanguage();
            document.documentElement.setAttribute('lang', lang);
            document.querySelectorAll('[data-i18n]').forEach(function (el) {
                el.textContent = window.tVcda(el.dataset.i18n);
            });
            document.querySelectorAll('[data-i18n-html]').forEach(function (el) {
                el.innerHTML = window.tVcda(el.dataset.i18nHtml);
            });
            const languageText = document.getElementById('languageToggleText');
            if (languageText) languageText.textContent = lang.toUpperCase();
            window.applyVcdaPhraseTranslations(lang);
            window.vcdaApplyingLanguage = false;
        };

        window.toggleVcdaLanguage = function () {
            const next = window.getVcdaLanguage() === 'es' ? 'en' : 'es';
            localStorage.setItem('vcdaLanguage', next);
            window.applyVcdaLanguage();
        };

        window.applyVcdaPhraseTranslations = function (lang) {
            const map = lang === 'en' ? vcdaPhraseTranslations : vcdaReversePhraseTranslations;
            const textWalker = document.createTreeWalker(document.body, NodeFilter.SHOW_TEXT, {
                acceptNode: function (node) {
                    const parent = node.parentElement;
                    if (!parent || parent.closest('script, style, code, pre, [data-no-i18n]')) {
                        return NodeFilter.FILTER_REJECT;
                    }
                    return node.nodeValue.trim() ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
                }
            });

            const textNodes = [];
            while (textWalker.nextNode()) textNodes.push(textWalker.currentNode);
            for (const node of textNodes) {
                const original = node.nodeValue;
                const leading = original.match(/^\s*/)?.[0] || '';
                const trailing = original.match(/\s*$/)?.[0] || '';
                const trimmed = original.trim();
                if (map[trimmed]) {
                    node.nodeValue = leading + map[trimmed] + trailing;
                }
            }

            document.querySelectorAll('input[placeholder], textarea[placeholder]').forEach(function (el) {
                const value = el.getAttribute('placeholder');
                if (value && map[value]) el.setAttribute('placeholder', map[value]);
            });

            document.querySelectorAll('[title]').forEach(function (el) {
                const value = el.getAttribute('title');
                if (value && map[value]) el.setAttribute('title', map[value]);
            });
        };

        window.togglePasswordVisibility = function (button) {
            const targetId = button?.getAttribute('data-toggle-password');
            const input = targetId ? document.getElementById(targetId) : null;
            if (!input) return;

            const visible = input.type === 'text';
            input.type = visible ? 'password' : 'text';
            button.setAttribute('aria-pressed', (!visible).toString());
            button.setAttribute('aria-label', visible ? button.dataset.showLabel : button.dataset.hideLabel);
            const icon = button.querySelector('.bi');
            if (icon) {
                icon.className = visible ? 'bi bi-eye' : 'bi bi-eye-slash';
            }
        };

        window.validateRegisterForm = function (form) {
            const password = form.querySelector('#Input\\.Password')?.value || '';
            const confirm = form.querySelector('#Input\\.ConfirmPassword')?.value || '';
            const email = form.querySelector('#Input\\.Email')?.value || '';
            const errors = [];
            const emailRegex = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;

            if (!email.trim()) errors.push(window.tVcda('register.emailRequired'));
            else if (!emailRegex.test(email)) errors.push(window.tVcda('register.emailInvalid'));
            if (password.length < 8) errors.push(window.tVcda('register.passwordMin'));
            if (!/[a-z]/.test(password)) errors.push(window.tVcda('register.passwordLower'));
            if (!/[A-Z]/.test(password)) errors.push(window.tVcda('register.passwordUpper'));
            if (!/[0-9]/.test(password)) errors.push(window.tVcda('register.passwordDigit'));
            if (!/[^a-zA-Z0-9]/.test(password)) errors.push(window.tVcda('register.passwordSymbol'));
            if (password !== confirm) errors.push(window.tVcda('register.passwordMismatch'));

            const box = document.getElementById('registerClientErrors');
            if (errors.length > 0) {
                if (box) {
                    box.innerHTML = '<strong>' + window.tVcda('register.clientHeader') + '</strong><ul class="mb-0 mt-2"><li>' + errors.join('</li><li>') + '</li></ul>';
                    box.classList.remove('d-none');
                }
                return false;
            }

            box?.classList.add('d-none');
            const submit = form.querySelector('[data-register-submit="true"]');
            if (submit) {
                submit.disabled = true;
                submit.dataset.originalText = submit.textContent;
                submit.textContent = window.getVcdaLanguage() === 'en' ? 'Creating account...' : 'Creando cuenta...';
            }
            return true;
        };

        window.startConfirmEmailRedirect = function () {
            let remaining = 5;
            const countdown = document.getElementById('confirmEmailCountdown');
            if (!countdown || countdown.dataset.started === 'true') return;
            countdown.dataset.started = 'true';

            const timer = window.setInterval(function () {
                remaining -= 1;
                countdown.textContent = remaining.toString();
                if (remaining <= 0) {
                    window.clearInterval(timer);
                    window.location.href = '/';
                }
            }, 1000);
        };

        window.setVcdaTutorialMode = function (mode) {
            document.querySelectorAll('[data-tutorial-mode]').forEach(function (button) {
                button.classList.toggle('active', button.dataset.tutorialMode === mode);
            });
            document.querySelectorAll('[data-tutorial-panel]').forEach(function (panel) {
                panel.classList.toggle('d-none', panel.dataset.tutorialPanel !== mode);
            });
        };

        window.closeVcdaTutorial = function () {
            const modal = document.getElementById('firstLoginTutorial');
            const userKey = modal?.dataset.tutorialUser || 'anonymous';
            localStorage.setItem('vcdaTutorialSeen:' + userKey, 'true');
            modal?.classList.add('d-none');
        };

        window.openVcdaTutorial = function () {
            const modal = document.getElementById('firstLoginTutorial');
            if (!modal) return;
            modal.classList.remove('d-none');
            window.applyVcdaLanguage?.();
        };

        window.showVcdaTutorialIfNeeded = function () {
            const modal = document.getElementById('firstLoginTutorial');
            const userKey = modal?.dataset.tutorialUser || 'anonymous';
            if (!modal || localStorage.getItem('vcdaTutorialSeen:' + userKey) === 'true') return;
            modal.classList.remove('d-none');
        };

        document.addEventListener('click', function (event) {
            const button = event.target.closest('[data-toggle-password]');
            if (button) {
                window.togglePasswordVisibility(button);
            }
        });

        document.addEventListener('submit', function (event) {
            if (event.target?.matches?.('[data-vcda-register-form="true"]') && !window.validateRegisterForm(event.target)) {
                event.preventDefault();
                event.stopPropagation();
            }
        }, true);

        document.addEventListener('DOMContentLoaded', window.applyVcdaLanguage);

        window.vcdaI18nObserver = new MutationObserver(function () {
            window.clearTimeout(window.vcdaI18nTimer);
            window.vcdaI18nTimer = window.setTimeout(window.applyVcdaLanguage, 50);
        });

        document.addEventListener('DOMContentLoaded', function () {
            window.vcdaI18nObserver.observe(document.body, { childList: true, subtree: true });
        });
    </script>
