# Copia este archivo a .env y reemplaza los placeholders.
# No guardes secretos reales en Git.

# URL publica usada en emails de confirmacion y recuperacion.
APP_PUBLIC_BASE_URL=https://localhost:8443

# Puertos publicados por Nginx.
APP_HTTP_PORT=8080
APP_HTTPS_PORT=8443

# Email usado por Let's Encrypt al emitir certificados productivos.
LETSENCRYPT_EMAIL=admin@example.com

# Peligroso si queda en true: borra y recrea la base SQLite al iniciar.
APP_RESET_DATABASE_ON_START=false

# Certificado PFX para cifrar claves de ASP.NET Core DataProtection en reposo.
# Archivo esperado por Docker Compose: docker-data/certs/dataprotection.pfx
DATAPROTECTION_CERT_PASSWORD=REEMPLAZAR_CON_PASSWORD_LARGO_UNICO

# Seed inicial de administrador.
# En Docker Compose se mapean a AdminSeed__... dentro del contenedor.
# Dejalo en false si vas a registrar usuarios manualmente o ya tenes una DB existente.
ADMIN_SEED_ENABLED=false
ADMIN_SEED_USERNAME=admin-local
ADMIN_SEED_EMAIL=admin@example.local
ADMIN_SEED_PASSWORD=REEMPLAZAR_CON_PASSWORD_LARGO_UNICO

# SMTP para confirmacion de email y recuperacion de contrasena.
# Para proveedores con MFA, usa una contrasena de aplicacion.
Smtp__Host=smtp.tu-proveedor.com
Smtp__Port=587
Smtp__EnableSsl=true
Smtp__FromEmail=notificaciones@tudominio.com
Smtp__FromName=VCDA-Financial-Manager
Smtp__Username=notificaciones@tudominio.com
Smtp__Password=REEMPLAZAR_CON_SECRETO_SMTP
